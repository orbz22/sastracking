# Copy ke .env lalu sesuaikan
APP_NAME=Viral Trend Intelligence
DATABASE_URL=sqlite:///./data/trends.db
REGION=ID
VERTICAL=fnb
REQUEST_TIMEOUT=20

# --- Sesi login scraper ---
# Default: profil terpisah (.pw-profile). Login sekali via scripts.login.
# Atau pakai Chrome asli kamu (reuse login TikTok yg udah ada) —
# WAJIB tutup SEMUA jendela Chrome saat scrape:
# PROFILE_DIR=C:\Users\raiha\AppData\Local\Google\Chrome\User Data
# PROFILE_SUBDIR=Default

# --- Kalau app dibuka ke internet (scripts/share.ps1) ---
# Gerbang HTTP Basic. WAJIB diisi sebelum tunnel dinyalakan: /refresh itu POST
# yang menjalankan Chrome pakai sesi TikTok mesin ini. Kosong = tanpa gerbang,
# cuma aman selama app didengarkan di 127.0.0.1 saja.
AUTH_USER=
AUTH_PASS=

# Tingkat kedua: boleh menekan tombol aksi walau READ_ONLY menyala. Ini kunci
# PRIBADI kamu — jangan dibagikan bersama AUTH_USER/AUTH_PASS di atas. Gunanya
# memisahkan "penonton boleh lihat" dari "saya boleh update dari jauh".
# Kosong = tidak ada jalur tulis dari jauh sama sekali.
ADMIN_USER=
ADMIN_PASS=

# true = POST ditolak untuk penonton biasa (tombol "Ambil data baru" & "Tarik
# dari sumber" mati). Pemegang ADMIN_* tetap boleh. share.ps1 menyalakannya
# otomatis kecuali dijalankan dengan -Bisatulis (yang membuka tulis ke SEMUA).
READ_ONLY=false
